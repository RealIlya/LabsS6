<?xml version="1.0"?>
<configuration>
	<system.web>

		<!--
      ВАЖНО: В данном проекте авторизация реализована через Session["User"],
      а не через Forms Authentication. Поэтому стандартный тег <authorization>
      с <deny users="?"/> НЕ РАБОТАЕТ — он проверяет IPrincipal/IIdentity,
      которые Session не заполняет.

      Реальная защита Admin-страниц обеспечивается проверкой в Page_Load:
        if (Session["User"] == null || !((User)Session["User"]).IsAdmin)
            Response.Redirect("~/Default.aspx");

      Этот Web.config выполняет вспомогательные функции:
      обработка ошибок и отключение отладочной информации.
    -->

		<!-- Скрываем трассировку стека от пользователя (исправление #3) -->
		<customErrors mode="On" defaultRedirect="~/Default.aspx">
			<error statusCode="403" redirect="~/Default.aspx" />
			<error statusCode="404" redirect="~/Default.aspx" />
			<error statusCode="500" redirect="~/Default.aspx" />
		</customErrors>

		<!-- Отладка должна быть выключена в production -->
		<compilation debug="false" />

	</system.web>
</configuration>


